{
  "name": "@krocosr/vocab",
  "version": "1.0.0",
  "description": "Self-hosted vocabulary builder — look up words while reading and save where you found them",
  "keywords": [
    "vocabulary",
    "vocabulary-builder",
    "dictionary",
    "words",
    "cli",
    "self-hosted",
    "wiktionary",
    "reading",
    "study"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krocosr/vocab.git"
  },
  "main": "dist/index.js",
  "bin": {
    "vocab": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "selfcheck": "tsx src/selfcheck.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
